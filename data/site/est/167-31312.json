xt":""}]},{"id":"145657","date":"2012-10-15","visit":"Routine","type_raw":"Original","risk":0,"repeat":0,"grp":0,"label":"Older report form","detail_url":"https://public.cdpehs.com/ILEnvPbl/ESTABLISHMENT/ShowViolationTablePage.aspx?ESTABLISHMENT=8614&ESTTST_CTY=sJRNEgWYzzs%3d&VIOLATION_INSPECTION=145657&INSPECTION_NN=145657","older":true,"fetched":true,"findings":[]},{"id":"130040","date":"2011-12-13","visit":"Routine","type_raw":"Original","risk":0,"repeat":0,"grp":0,"label":"Older report form","detail_url":"https://public.cdpehs.com/ILEnvPbl/ESTABLISHMENT/ShowViolationTablePage.aspx?ESTABLISHMENT=8614&ESTTST_CTY=sJRNEgWYzzs%3d&VIOLATION_INSPECTION=130040&INSPECTION_NN=130040","older":true,"fetched":true,"findings":[{"item":null,"title":"Potential for cross-contamination; storage practices; damaged food segregated","repeat":false,"comment":"Observed raw frozen beef patties srored above raw frozen egg product in the walk-in freezer.\nSec 750.130D - Store meat according to cooking temperatures in the walk-in freezer. \nCORRECTED: product was moved to new location, not aboce egg product.","citation":"","citation_text":""}]},{"id":"105251","date":"2010-03-16","visit":"Routine","type_raw":"Original","risk":0,"repeat":0,"grp":0,"label":"Older report form","detail_url":"https://public.cdpehs.com/ILEnvPbl/ESTABLISHMENT/ShowViolationTablePage.aspx?ESTABLISHMENT=8614&ESTTST_CTY=sJRNEgWYzzs%3d&VIOLATION_INSPECTION=105251&INSPECTION_NN=105251","older":true,"fetched":true,"findings":[]}]}