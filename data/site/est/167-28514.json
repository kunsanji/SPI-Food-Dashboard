gs":[]},{"id":"497927","date":"2024-04-15","visit":"Routine","type_raw":"Original","risk":0,"repeat":0,"grp":0,"label":"No violations found","detail_url":"https://public.cdpehs.com/ILEnvPbl/ESTABLISHMENT/ShowViolationTablePage.aspx?ESTABLISHMENT=8430&ESTTST_CTY=sJRNEgWYzzs%3d&VIOLATION_INSPECTION=497927&INSPECTION_NN=497927","older":false,"fetched":true,"findings":[]},{"id":"478854","date":"2023-10-25","visit":"Routine","type_raw":"Original","risk":1,"repeat":0,"grp":0,"label":"Minor issues","detail_url":"https://public.cdpehs.com/ILEnvPbl/ESTABLISHMENT/ShowViolationTablePage.aspx?ESTABLISHMENT=8430&ESTTST_CTY=sJRNEgWYzzs%3d&VIOLATION_INSPECTION=478854&INSPECTION_NN=478854","older":false,"fetched":true,"findings":[{"item":28,"title":"Toxic substances properly identified, stored, and used","repeat":false,"comment":"(P) 7-202.12 Quat solution was observed at 400ppm in sani-buckets. Product currently being used required a 200ppm concentration per label directions. Fresh solution was prepared at 200ppm. Ensure proper use of chemical sanitizer, and use test strips to verify concentration prior to use.\nChemical sanitizers must meet the concentration and use requirements specified by 40 CFR 180.940. Toxics shall be used according to the manufacturer's use directions included in labeling, and must not be used in a manner that poses a health hazard or potential risk of cross contamination.","citation":"","citation_text":""}]},{"id":"447559","date":"2023-02-24","visit":"Spot check","type_raw":"Spot Check","risk":0,"repeat":0,"grp":0,"label":"No violations found","detail_url":"https://public.cdpehs.com/ILEnvPbl/ESTABLISHMENT/ShowViolationTablePage.aspx?ESTABLISHMENT=8430&ESTTST_CTY=sJRNEgWYzzs%3d&VIOLATION_INSPECTION=447559&INSPECTION_NN=447559","older":false,"fetched":true,"findings":[]},{"id":"446968","date":"2023-02-17","visit":"Routine","type_raw":"Original","risk":0,"repeat":0,"grp":2,"label":"Minor issues","detail_url":"https://public.cdpehs.com/ILEnvPbl/ESTABLISHMENT/ShowViolationTablePage.aspx?ESTABLISHMENT=8430&ESTTST_CTY=sJRNEgWYzzs%3d&VIOLATION_INSPECTION=446968&INSPECTION_NN=446968","older":false,"fetched":true,"findings":[{"item":36,"title":"Thermometers provided & accurate","repeat":false,"comment":"","citation":"4-203.11","citation_text":"4-203.11 Food thermometers were observed reading at temperatures of 64F to 70F at ambient temperature in a storage drawer. Ice point method was used to verify accuracy. One thermometer was at 32F, while five others were observed reading below 30F and closer to 40F. Inspector’s bi-metallic stem thermometer wrench tool was used to adjust the remaining thermometers and calibrate to 32F. Thermometers available for use were purchased new recently and cases do not have a built-in in wrench tool for calibration. A small wrench and/or thermometer with a wrench tool will be provided to allow for adjustment when needed for future calibration. \nFood temperature measuring devices that are scaled only in Fahrenheit shall be accurate to ±2F in the intended range of use."},{"item":48,"title":"Warewashing facilities: installed, maintained, & used; test strips","repeat":false,"comment":"","citation":"4-302.13","citation_text":"4-302.13 Dish temp tester used at the facility had a dead battery. A spare battery was not available. New battery will be purchased for next week. Manager was asked to send a photo of the dish temp tester turned on once new battery is installed to show proper function.\nIn hot water mechanical warewashing operations, an irreversible registering temperature indicator shall be provided and readily accessible for measuring the utensil surface temperature. Surface temperature at dishes upon completion of final rinse must be at least 160F for proper heat sanitization."}]},{"id":"431527","date":"2022-09-20","visit":"Routine","type_raw":"Original","risk":0,"repeat":0,"grp":0,"label":"No violations found","detail_url":"https://public.cdpehs.com/ILEnvPbl/ESTABLISHMENT/ShowViolationTablePag